{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "review-once · 双 Mode 有界 Review-Fix 生命周期",
    "locale": "zh-CN",
    "subtitle": "Review → Chat → Fix → Verify → 收敛门 → 收敛 / 自审收敛 / 有界停止 / 阻塞",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": "docs/assets/review-once-workflow.html"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Review-Fix 主生命周期"
    },
    {
      "id": "evidence",
      "label": "取证 Mode"
    },
    {
      "id": "loop",
      "label": "验证回路"
    },
    {
      "id": "terminal",
      "label": "终态策略"
    }
  ],
  "states": [
    {
      "id": "request",
      "type": "start",
      "label": "开始 Review",
      "sublabel": "读取 Review request.md · 建立基线 BASELINE",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "scope",
      "width": 190
    },
    {
      "id": "review",
      "type": "decision",
      "label": "Review / Re-review",
      "sublabel": "自审无 Finding 须过收敛门 · 重新取证",
      "lane": "main",
      "col": 2,
      "step": "02",
      "tag": "Finding gate",
      "width": 170
    },
    {
      "id": "report",
      "type": "active",
      "label": "Chat 报告",
      "sublabel": "严重性 · 位置 · 影响 · 证据",
      "lane": "main",
      "col": 3,
      "step": "03",
      "tag": "evidence",
      "width": 140
    },
    {
      "id": "fix",
      "type": "active",
      "label": "最小 Fix",
      "sublabel": "只修复可证明的根因",
      "lane": "main",
      "col": 4,
      "step": "04",
      "tag": "bounded",
      "width": 140
    },
    {
      "id": "conductor",
      "type": "external",
      "label": "Conductor Mode",
      "sublabel": "GetWorkspaceDiff · Comments · Checks",
      "lane": "evidence",
      "col": 0,
      "tag": "MCP",
      "width": 170
    },
    {
      "id": "git",
      "type": "external",
      "label": "Git fallback Mode",
      "sublabel": "merge-base · git diff · Chat 证据",
      "lane": "evidence",
      "col": 1,
      "tag": "CLI",
      "width": 160
    },
    {
      "id": "verify",
      "type": "decision",
      "label": "Verify",
      "sublabel": "相关测试 / Lint / 静态检查",
      "lane": "loop",
      "col": 4,
      "tag": "feedback",
      "width": 140
    },
    {
      "id": "converged",
      "type": "success",
      "label": "收敛",
      "sublabel": "独立复审无 Finding · 验证有效",
      "lane": "terminal",
      "col": 2,
      "tag": "done",
      "width": 140
    },
    {
      "id": "bounded",
      "type": "failure",
      "label": "有界停止",
      "sublabel": "重复 / 无进展 / 8 轮 / 争议再报出",
      "lane": "terminal",
      "col": 3,
      "tag": "decision",
      "width": 160
    },
    {
      "id": "blocked",
      "type": "failure",
      "label": "阻塞",
      "sublabel": "工具 / 权限 / 决策不足",
      "lane": "terminal",
      "col": 4,
      "tag": "halt",
      "width": 140
    },
    {
      "id": "self_reviewed",
      "type": "waiting",
      "label": "自审收敛",
      "sublabel": "冷启动自审无 Finding · 未经独立复审",
      "lane": "terminal",
      "col": 1,
      "tag": "degraded",
      "width": 160
    },
    {
      "id": "disputed",
      "type": "decision",
      "label": "误报复核 DISPUTED",
      "sublabel": "不改代码 · 新 reviewer 复核中",
      "lane": "loop",
      "col": 3,
      "tag": "dispute",
      "width": 140
    }
  ],
  "transitions": [
    {
      "id": "request-conductor",
      "from": "request",
      "to": "conductor",
      "label": "MCP 可用",
      "variant": "emphasis"
    },
    {
      "id": "request-git",
      "from": "request",
      "to": "git",
      "label": "fallback",
      "variant": "default"
    },
    {
      "id": "conductor-review",
      "from": "conductor",
      "to": "review",
      "label": "Diff + Comments",
      "variant": "emphasis"
    },
    {
      "id": "git-review",
      "from": "git",
      "to": "review",
      "label": "base + Diff",
      "variant": "default"
    },
    {
      "id": "review-report",
      "from": "review",
      "to": "report",
      "label": "Finding",
      "variant": "emphasis"
    },
    {
      "id": "report-fix",
      "from": "report",
      "to": "fix",
      "label": "安全修复",
      "variant": "default"
    },
    {
      "id": "fix-verify",
      "from": "fix",
      "to": "verify",
      "label": "最小补丁",
      "variant": "default"
    },
    {
      "id": "verify-review",
      "from": "verify",
      "to": "review",
      "label": "重新取证",
      "variant": "emphasis"
    },
    {
      "id": "review-converged",
      "from": "review",
      "to": "converged",
      "label": "收敛门：独立复审",
      "variant": "security"
    },
    {
      "id": "review-bounded",
      "from": "review",
      "to": "bounded",
      "label": "停止条件",
      "variant": "security"
    },
    {
      "id": "review-self-reviewed",
      "from": "review",
      "to": "self_reviewed",
      "label": "无法委派：冷启动自审",
      "variant": "default"
    },
    {
      "id": "review-blocked",
      "from": "review",
      "to": "blocked",
      "label": "工具 / 权限 / 决策不足（任何状态可触发）",
      "variant": "default"
    },
    {
      "id": "verify-blocked",
      "from": "verify",
      "to": "blocked",
      "label": "验证失败但与本轮无关",
      "variant": "default"
    },
    {
      "id": "review-disputed",
      "from": "review",
      "to": "disputed",
      "label": "收敛门 Finding 判定误报",
      "variant": "default"
    },
    {
      "id": "disputed-converged",
      "from": "disputed",
      "to": "converged",
      "label": "未再报出 → 按其余结果收敛",
      "variant": "emphasis"
    },
    {
      "id": "disputed-bounded",
      "from": "disputed",
      "to": "bounded",
      "label": "再次报出 → 交用户裁决",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "共享契约",
      "items": [
        "两个 Mode 只改变取证载体，不改变 Finding 判定与停止语义",
        "Finding 判定、状态机与报告格式以 Review Contract 为唯一事实源；停止预算与轮次以 SKILL.md 为准"
      ]
    },
    {
      "dot": "amber",
      "title": "每轮新证据",
      "items": [
        "Verify 必须回到 Review / Re-review，不复用陈旧结论",
        "测试失败先作为回归处理，不能宣称 Review 已完成"
      ]
    },
    {
      "dot": "rose",
      "title": "有界终止",
      "items": [
        "重复 Finding、连续无进展或第 8 轮触发有界停止；阻塞（工具/权限/决策不足）是与之并列的独立终态",
        "误报复核 DISPUTED：新 reviewer 未再报出则按其余结果收敛，再次报出则有界停止并交用户裁决",
        "收敛须经 fresh-context 独立复审；无法委派只能标「自审收敛」，收敛后任何改动使结论作废；收敛门完整出边以 review-contract.md 状态机为准"
      ]
    }
  ]
}
