  "edges": [
    { "id": "route-conductor", "from": "route", "to": "conductor", "label": "工具可用", "variant": "emphasis", "role": "branch" },
    { "id": "route-git", "from": "route", "to": "git", "label": "工具不可用", "variant": "default", "role": "branch" },
    { "id": "conductor-review", "from": "conductor", "to": "review", "label": "Checks / Diff / Comments", "variant": "emphasis" },
    { "id": "git-review", "from": "git", "to": "review", "label": "base + Diff + checks", "variant": "default" },
    { "id": "review-chat", "from": "review", "to": "chat", "label": "Finding 或无 Finding", "variant": "emphasis" },
    { "id": "chat-fix", "from": "chat", "to": "fix", "label": "可安全修复", "variant": "default" },
    { "id": "fix-verify", "from": "fix", "to": "verify", "label": "最小补丁", "variant": "default" },
    { "id": "verify-converged", "from": "verify", "to": "converged", "label": "无 Finding 且验证通过", "variant": "security", "role": "return" },
