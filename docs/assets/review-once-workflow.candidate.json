  "mainPath": ["route", "conductor", "review", "chat", "fix", "verify"],
  "nodes": [
    { "id": "route", "lane": "routing", "col": 0, "type": "backend", "label": "选择 Mode", "sublabel": "工具可用性 + 基线", "tag": "先定证据范围", "width": 150 },
    { "id": "conductor", "lane": "conductor", "col": 1, "type": "frontend", "label": "Conductor Mode", "sublabel": "Diff Viewer + Checks + Comments", "width": 170 },
    { "id": "git", "lane": "git", "col": 1, "type": "backend", "label": "Git fallback Mode", "sublabel": "merge-base Diff + Chat 记录", "width": 170 },
    { "id": "review", "lane": "loop", "col": 2, "type": "backend", "label": "Review / Re-review", "sublabel": "每轮重新获取 Diff、评论和结果", "tag": "Evaluator + Optimizer", "width": 180 },
    { "id": "chat", "lane": "loop", "col": 3, "type": "frontend", "label": "Chat", "sublabel": "严重性 · 位置 · 影响 · 证据", "width": 160 },
