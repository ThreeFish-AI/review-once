    { "id": "evidence_loop", "label": "每轮重新取证，不复用陈旧结论", "lane": "loop", "fromCol": 2, "toCol": 5, "variant": "dashed" },
    { "id": "stop_policy", "label": "无 Finding / 阻塞 / 达到上限", "lane": "routing", "fromCol": 4, "toCol": 5, "variant": "security" }
