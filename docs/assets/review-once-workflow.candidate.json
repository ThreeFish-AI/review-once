    { "id": "converged", "lane": "routing", "col": 4, "type": "security", "label": "收敛", "sublabel": "无明确 Finding + 验证无未解释失败", "width": 175 },
    { "id": "bounded", "lane": "routing", "col": 5, "type": "security", "label": "有界停止", "sublabel": "重复 / 无进展 / 阻塞 / 8 轮", "width": 175 }
