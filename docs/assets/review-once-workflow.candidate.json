  "cards": [
    {
      "dot": "cyan",
      "title": "共享契约",
      "items": [
        "两个 Mode 只改变取证载体，不改变 Finding 判定与停止语义",
        "主循环与 Review Contract 保持唯一事实源"
      ]
    },
    {
      "dot": "rose",
      "title": "有界反馈",
      "items": [
        "Review / Re-review 只接受新 Diff、评论和验证证据",
        "Conductor Merge readiness 仍由 Checks、评论、Todo 与 CI 独立决定"
      ]
    }
  ]
